# Keep the build context (and image) small. fonts/, note_configs/, branding/,
# app/, core/, data/, web/ (source — built in the node stage) are all needed and
# intentionally NOT ignored.
.venv
venv
env
# Front-end: node_modules is reinstalled (npm ci) and dist is rebuilt in the
# node stage, so neither should ship in the build context.
web/node_modules
web/dist
**/__pycache__
*.pyc
*.pyo
.git
.gitignore
.gitattributes
.DS_Store
.claude
docs
# The C++ engine IS built into the deploy now (cpp-build stage compiles a portable
# wheel; the final image installs it). cpp/ and core/simulator_cpp.py must ship.
scripts/verify_pdf.py
scripts/compare_engines.py
# Local-only branding overrides + commercial brand fonts (the example template and
# the bundled IBM Plex family are kept). These are gitignored too, so the
# Cloud Build checkout never has them — this is belt-and-suspenders for local builds.
branding/branding_*.json
!branding/branding_example.json
fonts/brand/*.ttf
fonts/brand/*.otf
# Build/test artifacts
*.egg-info
.pytest_cache
.ipynb_checkpoints
wheelhouse
dist
build
